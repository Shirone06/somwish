rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // คำอวยพรจากพนักงาน
    match /wishes/{doc} {

      // ใครก็อ่านได้ (หน้าสไลด์ต้องอ่านมาแสดง)
      allow read: if true;

      // ใครก็ส่งคำอวยพรได้ แต่ต้องผ่านการตรวจข้อมูล (กันสแปม/ไฟล์ใหญ่)
      allow create: if
        request.resource.data.keys().hasOnly(['name','message','photo','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 600
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 900000   // ~รูปย่อ 1 รูป (ต่ำกว่าลิมิต 1MB/เอกสาร)
        && request.resource.data.createdAt is timestamp;

      // ห้ามแก้/ลบผ่านหน้าเว็บ (ถ้าจะลบคำอวยพรไม่เหมาะสม ให้ลบจาก Firebase Console)
      allow update, delete: if false;
    }
  }
}
